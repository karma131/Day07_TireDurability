# Embedding provider selection for manual experiments
# EMBEDDING_PROVIDER=mock
# EMBEDDING_PROVIDER=local
EMBEDDING_PROVIDER=openai

# Optional: set cache directories for the local multilingual embedder
# HF_HOME=./.hf-cache
# SENTENCE_TRANSFORMERS_HOME=./.sentence-transformers

# Optional: OpenAI embedding configuration
OPENAI_API_KEY=your-key-here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Agent generation is intentionally fixed to gpt-4o-mini in the evaluation script.

# Corpus for the K3 VinUniversity library benchmark
LAB_DATA_DIR=data/vinuni_library_services
# MEMBER4_OUTPUT_DIR=results/member4_recursive

# Optional: for ChromaDB persistence (bonus task)
# CHROMA_PERSIST_DIR=./chroma_data
